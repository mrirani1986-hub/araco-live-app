# Copy to .env and change every value marked CHANGE_ME.
DATABASE_URL=postgresql://araco:CHANGE_ME@localhost:5432/araco_spares
PORT=4100
NODE_ENV=development
JWT_SECRET=CHANGE_ME_to_a_long_random_string_at_least_32_chars
SESSION_HOURS=12
CORS_ORIGIN=http://localhost:5174
# Where images, imports, exports and backups are kept (relative to spare-parts/)
STORAGE_DIR=../../storage
STORAGE_DRIVER=local
# Chromium used for server-side PDF generation
CHROMIUM_PATH=/opt/pw-browsers/chromium
# First administrator (created by `npm run seed` only if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FULL_NAME=System Administrator
# pg_dump / pg_restore used by backup & restore
PG_BIN_DIR=/usr/lib/postgresql/16/bin
